<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Login - CAMAAR</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag 'login', media: 'all' %>
</head>
<body>
<div class="login-container">
  <div class="login-form">
    <h2>LOGIN</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-group">
        <%= f.label :email, "Email ou Matrícula" %><br>
        <%= f.text_field :email, autofocus: true, autocomplete: "login", class: "input", value: "aluno@aluno.unb.br"%>
      </div>

      <div class="form-group">
        <%= f.label :password, "Senha" %><br>
        <%= f.password_field :password, autocomplete: "current-password", class: "input", value: "Password" %>
      </div>

      <div class="form-actions">
        <%= f.submit "Entrar", class: "btn" %>
      </div>
      <% if flash[:alert] %>
        <div class="alert-message">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="notice-message">
          <%= flash[:notice] %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="login-banner">
    <h1>Bem vindo<br>ao<br>Camaar</h1>
  </div>
</div>
</body>
</html>
