<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Login - CAMAAR</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag 'login', "gerenciamento", media: 'all' %>
</head>
<body>

<% if flash[:notice] %>
  <div class="flash flash-notice"><%= flash[:notice] %></div>
<% end %>

<% if flash[:success] %>
  <div class="flash flash-success"><%= flash[:success] %></div>
<% end %>

<% if flash[:warning] %>
  <div class="flash flash-warning"><%= flash[:warning] %></div>
<% end %>

<% if flash[:error] %>
  <div class="flash flash-error"><%= flash[:error] %></div>
<% end %>

<% if flash[:alert] %>
  <div class="flash flash-alert"><%= flash[:alert] %></div>
<% end %>

<div class="login-container">
  <div class="login-form">
    <h2>LOGIN</h2>

    <%= form_for(@resource, as: @resource_name, url: pessoa_session_path, html: { method: :post }) do |f| %>
      <div class="form-group">
        <%= f.label :login, "Email ou Matrícula" %><br>
        <%= f.text_field :login, autofocus: true, class: "input"%>
      </div>

      <div class="form-group">
        <%= f.label :password, "Senha" %><br>
        <%= f.password_field :password, class: "input"%>
      </div>

      <div class="form-actions">
        <%= f.submit "Entrar", class: "btn" %>
      </div>
    <% end %>
  </div>

  <div class="login-banner">
    <h1>Bem vindo<br>ao<br>Camaar</h1>
  </div>
</div>
</body>
</html>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const alerts = [
      { selector: ".flash-notice", delay: 2000 },
      { selector: ".flash-success", delay: 2000 },
      { selector: ".flash-warning", delay: 2000 },
      { selector: ".flash-error", delay: 5000 },
      { selector: ".flash-alert", delay: 2000 },
    ];

    alerts.forEach(({ selector, delay }) => {
      const alertBox = document.querySelector(selector);
      if (alertBox) {
        setTimeout(() => {
          alertBox.style.opacity = "0";
          setTimeout(() => alertBox.remove(), 500);
        }, delay);
      }
    });
  });
</script>
