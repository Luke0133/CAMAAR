<div class="topbar">
  <div class="topbar-left">
    <div class="logo">Camaar</div>
  </div>
  <div class="topbar-right">
    <input class="search-bar" type="text" placeholder="Buscar...">
    <div class="user-icon">A</div>
  </div>
</div>

<div class="main-container">
  <div class="sidebar">
    <nav>
      <ul>
        <li class="menu-item active">Formulários</li>
        <li class="menu-item">Outro Menu</li>
      </ul>
    </nav>
  </div>

  <div class="content">
    <section class="main-area">

      <% if @template_error %>
        <div class="alert alert-warning">
          <%= @template_error %>
        </div>
      <% end %>

      <% if @materia_error %>
        <div class="alert alert-warning">
          <%= @materia_error %>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="alert alert-success">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <h1>Criar Formulário de Avaliação</h1>

      <%= form_with model: @formulario, url: formularios_path, local: true do |form| %>
        <div class="form-group">
          <%= form.label :template_id, "Template" %><br>
          <%= form.select :template_id,
                          options_from_collection_for_select(@templates, :id, :nome),
                          prompt: "Selecione um template",
                          class: "form-control" %>
        </div>

        <div class="form-group">
          <%= form.label :materia_id, "Matéria" %><br>
          <%= form.select :materia_id,
                          options_from_collection_for_select(@materias, :id, :nome),
                          prompt: "Selecione uma matéria",
                          class: "form-control" %>
        </div>

        <%= form.submit "Enviar", class: "btn btn-primary" %>
      <% end %>

    </section>
  </div>
</div>
