<section class="main-area">

  <% if @show_incompatibility_message %>
    <div class="flash flash-warning">
      Um ou mais templates estão incompatíveis e não podem ser visualizados.
    </div>
  <% end %>

  <div class="templates-list">
    <div class="template-card new">
      <%= button_to "Novo template", new_admin_template_path, method: :get, class: "btn btn-primary" %>
    </div>

  <% if @valid_templates.any? %>
      <% @valid_templates.each do |template| %>
        <div class="template-card">
          <strong><%= template.nome %></strong>
          <div class="form-actions">
            <%= button_to "Editar", edit_admin_template_path(template), method: :get, class: "btn btn-secondary" %>
            <form action="<%= admin_template_path(template) %>" method="post" onsubmit="return confirm('Tem certeza que deseja excluir o template <%= j template.nome %>?');">
              <input type="hidden" name="_method" value="delete">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <input type="submit" value="Excluir" class="btn btn-delete">
            </form>
          </div>
        </div>
      <% end %>
  <% else %>
    <div class="flash flash-alert">
      Nenhum template encontrado.
    </div>
  <% end %>
  </div>
</section>