<section class="main-area">
  <div class="button-container">
  <!-- Mensagens de erro/aviso -->
  <% if @template_error %>
    <div class="alert alert-warning"><%= @template_error %></div>
  <% end %>
  <% if @materia_error %>
    <div class="alert alert-warning"><%= @materia_error %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="alert alert-success"><%= flash[:notice] %></div>
  <% end %>

  <%= form_with model: @formulario, url: admin_formularios_path, local: true, html: { class: "formulario-form" } do |form| %>

    <!-- Dropdown de Templates -->
    <div class="form-group">
      <%= form.label :template_id, "Selecione o Template:" %><br>
      <%= form.select :template_id,
                      options_from_collection_for_select(@templates, :id, :nome),
                      prompt: "Template",
                      class: "dropdown-select" %>
    </div>

    <!-- Tabela de Matérias + Turmas -->
    <table class="materias-table">
      <thead>
        <tr>
          <th></th>
          <th>Matéria</th>
          <th>Semestre</th>
          <th>Código</th>
        </tr>
      </thead>
      <tbody>
        <% @materias.each do |materia| %>
          <% turma = @turmas_por_materia[materia] %>
          <tr>
            <td>
              <%= check_box_tag "formulario[materia_ids][]", materia.id, false, class: "checkbox" %>
            </td>
            <td><%= materia.nome %></td>
            <td><%= turma&.semestre || '-' %></td>
            <td><%= materia.id || '-' %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <!-- Seletor de Destino -->
    <div class="destino-selector">
      <%= hidden_field_tag 'formulario[destino]', 'todos', id: 'formulario_destino' %>

      <div class="destino-buttons">
        <button type="button" class="destino-btn active" data-value="todos">Todos</button>
        <button type="button" class="destino-btn" data-value="aluno">Alunos</button>
        <button type="button" class="destino-btn" data-value="professor">Professores</button>
      </div>
    </div>

    <!-- Botão Enviar -->
    <div class="submit-container">
      <%= form.submit "Enviar", class: "btn-enviar" %>
    </div>

  <% end %>

  </div>
</section>


<script>
  document.addEventListener("DOMContentLoaded", function () {
    const buttons = document.querySelectorAll(".destino-btn");
    const hiddenField = document.getElementById("formulario_destino");

    buttons.forEach(btn => {
      btn.addEventListener("click", function () {
        // Remove 'active' de todos
        buttons.forEach(b => b.classList.remove("active"));
        // Adiciona 'active' no atual
        this.classList.add("active");
        // Define o valor do campo hidden
        hiddenField.value = this.dataset.value;
      });
    });
  });
</script>