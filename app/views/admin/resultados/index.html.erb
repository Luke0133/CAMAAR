<section class="main-area">
  <% if flash[:download_form_id] %>
    <iframe
        src="<%= admin_download_resultado_path(flash[:download_form_id]) %>"
        style="display:none;"
    ></iframe>
  <% end %>

  <% if @forms.any? %>

    <% if @current_pessoa&.cargos&.any? { |c| c.funcao == 2 } %>
      <div class="filter-button-wrapper">
      <button id="toggle-filter" class="btn-filter">
        Mostrar apenas minhas turmas
      </button>
      </div>
    <% end %>

    <div class="formularios-list">
      <% @forms.each do |formulario| %>
        <% turma = formulario.turma %>
        <% materia = turma&.materia %>
        <div class="formulario-card<%= ' nao-respondido' unless formulario.respostas.any? %>"
             data-professor="<%= formulario.turma.professor == @current_pessoa.nome %>">
          <strong><%= formulario.nome %></strong><br>
          <span><%= materia&.nome || '-' %></span><br>
          <span><%= turma&.semestre || '-' %></span><br>
          <span>Turma: <%= turma&.numero_turma || '-' %></span><br>
          <span><%= turma&.professor || '-' %></span><br>
          <% if formulario.respostas.any? %>
            <%= link_to admin_preparar_download_path(formulario),
                        class: "download-btn",
                        title: "Download CSV" do %>
                Download
          <% end %>
          <% else %>
            <%= link_to admin_preparar_download_path(formulario),
                        class: "download-btn disabled",
                        title: "Sem respostas" do %>
            Download
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="flash flash-alert">
      Nenhum formulário encontrado.
    </div>
  <% end %>
</section>


<script>
    document.addEventListener("DOMContentLoaded", () => {
        const toggleBtn = document.getElementById("toggle-filter");
        let filterOn = false;

        if (toggleBtn) {
            toggleBtn.addEventListener("click", () => {
                filterOn = !filterOn;
                document.querySelectorAll(".formulario-card").forEach(card => {
                    const isProf = card.dataset.professor === "true";
                    card.style.display = (filterOn && !isProf) ? "none" : "block";
                });

                toggleBtn.textContent = filterOn
                    ? "Mostrar todos os formulários"
                    : "Mostrar apenas minhas turmas";
            });
        }
    });
</script>